[Unit]
Description=Reprise music runtime
Documentation=https://github.com/marvinbaudach/reprise
# The runtime is reached only over the session bus, so it has nothing to do
# without one.
Requires=dbus.socket
After=dbus.socket

[Service]
# Type=dbus: systemd considers the service started once it owns BusName, which
# is exactly the Starting -> Serving transition of the plan's section 9.2.
Type=dbus
BusName=org.reprise.Reprise1
ExecStart=@bindir@/reprise-runtime
# Never restarted automatically. A runtime that exits has either finished its
# idle grace (the intended end, and the bus will activate a new one on the
# next command) or refused to start because another process holds the lease —
# and restarting into a lease someone else holds is a loop, not a recovery.
Restart=no
# The runtime holds the database writer. Killing only the main process leaves
# no worker behind to finish a half-written transaction.
KillMode=mixed
TimeoutStopSec=10
