<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- SAF grants access to the selected tree without broad storage permissions. -->

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!--
        Artist portraits use Rust's bundled rustls + webpki-roots certificate
        chain, so they do not depend on Android's certificate store. On Android,
        artwork downloads are always on, with no switch or off state.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        From API 33 the playing notification is only shown once the user has
        allowed notifications. Without it the service still runs and the music
        still plays; only the transport in the shade and on the lock screen
        stays invisible. MainActivity asks at the first playback command.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        The queue's drag handle answers with the vibrator rather than with the
        platform's single-pulse feedback, because two of its four moments are
        not one pulse: a drop is a firm tap plus a lighter echo. Granted at
        install and never prompted for; the app still asks the system's touch
        feedback setting before every pulse, and a device without a vibrator
        runs the same gesture with nothing but the animation.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Glance pulls in WorkManager, which asks to be told when the phone boots so
        it can re-arm its periodic jobs. Reprise schedules none, so the
        permission would only be a grant nobody uses.
    -->
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED"
        tools:node="remove" />

    <!--
        Since API 30 an app only sees the packages it declares here, plus
        force-queryable system packages. Without this block Reprise cannot
        resolve a launcher's controller package through PackageManager, so
        media3 treats it as untrusted and hands it only read-only commands
        (metadata, playback state) — a launcher's play/pause/next/previous
        buttons then silently do nothing, even though the session, its
        state and its advertised actions all look correct. media3 logs
        the exact failure inside Reprise's process under the tag
        `MediaSessionManager`: "Package … doesn't exist" (#982).
        The notification-listener intent makes every app that exposes a
        NotificationListenerService visible — exactly the set media3 trusts
        among third-party controllers.
    -->
    <queries>
        <!--
            The browse service checks the signing certificate of the packages it
            lets browse beyond the platform's own trust (Android Auto, Wear OS),
            and a package is only readable here if it is declared.
        -->
        <package android:name="com.google.android.projection.gearhead" />
        <package android:name="com.google.android.wearable.app" />
        <intent>
            <action android:name="android.service.notification.NotificationListenerService" />
        </intent>
    </queries>

    <!--
        Android 26 and 27 otherwise permit cleartext traffic by default. The
        portrait client already enforces HTTPS; this pins the platform side as
        a second lock.

        The browse service answers search with "not supported", so no activity
        claims `MEDIA_PLAY_FROM_SEARCH`: a voice request would find nothing to
        play. Add the filter together with search, not before it.
    -->
    <application
        tools:ignore="MissingIntentFilterForMediaSearch"
        android:name=".RepriseApplication"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Spike"
        android:usesCleartextTraffic="false">
        <!--
            A day/night flip is a recomposition, not a restart: without this the
            OS destroys and recreates the activity, and the search text, the
            selected tab and the scroll position go with it. Compose republishes
            the configuration to `isSystemInDarkTheme()` on its own, so the
            palette and the system bar icons still follow the system. Rotation
            is deliberately left to recreate the activity.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
            No `android:process` here, and adding one has a cost worth knowing
            before you do. The play-count journal that carries counted plays
            across process death is a single-writer file: the second writer to
            open it is refused its exclusive lock and its plays are dropped with
            a warning rather than silently overwriting the first writer's. So a
            service in its own process would stop counting plays until that
            journal learns to be shared.
        -->
        <service
            android:name=".ReprisePlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
            <!--
                The browse tree: media3's own action for apps, and the platform's
                legacy one, which Android Auto still binds with.
            -->
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <!--
            The home-screen widget, offered twice: a wide placement (4x1) and a
            square one (2x2). Both draw the same Glance widget, which picks its
            layout from the size the launcher actually gives it.
        -->
        <receiver
            android:name=".widget.RepriseWideWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label_wide">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/reprise_widget_wide_info" />
        </receiver>
        <receiver
            android:name=".widget.RepriseSquareWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label_square">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/reprise_widget_square_info" />
        </receiver>
        <!--
            Tells Android Auto this app is a media app. Without it the head unit
            does not list Reprise, however well the browse tree answers.
        -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
    </application>

</manifest>
