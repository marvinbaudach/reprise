msgstr "Añadido: los detalles se completarán cuando vuelvas a tener conexión"

msgid "This source is already subscribed"
msgstr "Ya estás suscrito a esta fuente"

msgid "YouTube component is unavailable — reinstall or repair Reprise"
msgstr ""
"El componente de YouTube no está disponible: reinstala o repara Reprise"

