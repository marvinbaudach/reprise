# Maintainer: Marvin Baudach <tomateq@pm.me>

pkgname=reprise-git
pkgver=0.1.1.r0.g0000000
pkgrel=1
pkgdesc='Native GTK4 music player for GNOME (development version)'
arch=('x86_64')
url='https://github.com/marvinbaudach/reprise'
license=('GPL-3.0-or-later')
depends=(
  'cairo'
  'gdk-pixbuf2'
  'glib2'
  'graphene'
  'gstreamer>=1.0'
  'gst-plugins-base-libs'
  'gst-plugins-good'
  'gtk4>=1:4.22'
  'gvfs-mtp'
  'libadwaita>=1:1.9'
  'pango'
)
makedepends=(
  'gettext'
  'git'
  'meson>=1.3'
  'ninja'
  'rust>=1.92'
)
optdepends=(
  'gnome-keyring: Secret Service provider for stored account credentials'
  'gst-libav: additional FFmpeg-backed audio codecs'
  'gst-plugins-bad: additional GStreamer audio codecs'
  'gst-plugins-ugly: additional GStreamer audio codecs'
  'onnxruntime: experimental ML stem separation'
)
provides=('reprise')
conflicts=('reprise')
source=('reprise::git+https://github.com/marvinbaudach/reprise.git')
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/reprise"

  local meson_version
  meson_version=$(sed -n "s/^[[:space:]]*version: '\([^']*\)',/\1/p" meson.build)
  printf '%s.r%s.g%s' \
    "$meson_version" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cargo fetch --locked --manifest-path "$srcdir/reprise/Cargo.toml"
}

build() {
  export CARGO_NET_OFFLINE=true

  arch-meson "$srcdir/reprise" build --prefix=/usr -Dprofile=release
  meson compile -C build
}

package() {
  DESTDIR="$pkgdir" meson install -C build
  install -Dm644 "$srcdir/reprise/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
