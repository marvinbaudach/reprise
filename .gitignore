# Rust build output
/target

# Editor directories and files
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
*.log

# Session scratch (not part of the repo)
.superpowers/

# Git worktrees (local development)
.worktrees/

# Claude Code personal settings (machine-specific hooks)
.claude/settings.local.json

# Agent orchestration artefacts (plans, specs, status)
.orchestra-plan.json
.orchestra-status.md
SPEC.md
doc/
.claude/worktrees/

# `docs/` is tracked on purpose: it is how humans and agents hand work over
# (conventions in docs/agents, decisions in docs/adr, briefs in docs/plans).
# It was ignored while it collected generated status dumps — keep those out
# (session scratch belongs in .superpowers/) and docs/ stays worth reading.

# Pipeline scratch files (codex-run.sh writes these per run)
.pipeline-task.md
.pipeline-codex.md

# Accidental SQLite scratch created by GNOME tests
/crates/reprise-gnome/unused.db*

# Test-run caches. Verification runs point XDG_CACHE_HOME at the worktree so a
# GTK/GStreamer test cannot poison the real user cache; without this, a
# `git add -A` sweeps the resulting registry, shader cache and cover thumbnails
# into a commit (it happened once, in ac4c59ca36).
.cache/
