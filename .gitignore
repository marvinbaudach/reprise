# Rust build output
/target

# Editor directories and files
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
*.log

# Session scratch (not part of the repo)
.superpowers/

# Git worktrees (local development)
.worktrees/

# Claude Code personal settings (machine-specific hooks)
.claude/settings.local.json

# Agent orchestration artefacts (plans, specs, status)
.orchestra-plan.json
.orchestra-status.md
SPEC.md
doc/
.claude/worktrees/

# `docs/` is tracked on purpose: it is how humans and agents hand work over
# (conventions in docs/agents, decisions in docs/adr, briefs in docs/plans).
# It was ignored while it collected generated status dumps — keep those out
# (session scratch belongs in .superpowers/) and docs/ stays worth reading.

# Pipeline scratch files, written per run by the pipeline skill's runner: the
# prompt it is handed, and the summary it writes back. A glob rather than a
# list — the refactor phase adds .pipeline-refactor.md, and a name that escapes
# the list gets committed by accident. .pipeline-codex.md did exactly that in
# bc5a8e85f9, and every run afterwards left its worktree dirty, which made the
# architecture lint exit 2 on a whitespace complaint about a scratch file.
.pipeline-*.md

# Accidental SQLite scratch created by GNOME tests
/crates/reprise-gnome/unused.db*
# A test run started from the workspace root leaves the same file there.
unused.db*

# Test-run caches. Verification runs point XDG_CACHE_HOME at the worktree so a
# GTK/GStreamer test cannot poison the real user cache; without this, a
# `git add -A` sweeps the resulting registry, shader cache and cover thumbnails
# into a commit (it happened once, in ac4c59ca36 — and again in f70d563112,
# which is why the pattern is no longer just `.cache/`: runs name the directory
# whatever they like, and `.cache-test/` slipped straight past the old entry).
.cache/
.cache-*/

# Android: machine-specific SDK path, built native libraries, and the UniFFI
# Kotlin bindings — all three are generated by scripts/android-build.sh and
# must never be committed. A checked-in binding file silently drifts from the
# Rust signatures it is supposed to mirror.
android/local.properties
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/app/src/main/jniLibs/
android/app/src/main/java/uniffi/
android/keystore.properties
*.jks
*.keystore

# A Gradle home inside the worktree. The sandboxed Codex runs cannot write to
# `~/.gradle`, so they are pointed here instead — a gigabyte of downloaded
# distribution and caches that a stray `git add -A` would otherwise swallow.
.gradle-user-home/

# Python-Bytecode der Skripte unter scripts/lib
__pycache__/
*.pyc

# Agent-Werkzeuge und Zwischenstände dieser Maschine — nie Teil des Repos.
.claude/
.agents/
.tmp/
skills-lock.json
